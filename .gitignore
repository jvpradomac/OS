*.xlsx
*.xlsm
*.xls
*.csv
*.pdf
*.pptx
*.docx
*.msg
*.eml
!/guia/**

# ── Lixo de sistema ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
~$*
